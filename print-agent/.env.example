# Identifiants USB : `lsusb` → « ID 0416:5011 » → 0x0416 / 0x5011
PRINTER_VENDOR_ID=0x0416
PRINTER_PRODUCT_ID=0x5011
# Points de terminaison USB (valeurs par défaut de la plupart des imprimantes ESC/POS)
PRINTER_IN_EP=0x82
PRINTER_OUT_EP=0x01
# 48 caractères = 80 mm · 32 = 58 mm (bloquant n° 2 : à confirmer à réception)
PRINTER_WIDTH=48
PRINTER_CODEPAGE=CP858
# Impulsion tiroir, en hexadécimal : ESC p 0 25 250 (certains modèles : ESC p 1 → 1b700119fa)
DRAWER_PULSE=1b700019fa
# usb = imprimante réelle · dummy = aucune imprimante (développement), le ticket va dans le journal
PRINTER_BACKEND=usb

AGENT_HOST=127.0.0.1
AGENT_PORT=8090
# Obligatoire si AGENT_HOST n'est pas 127.0.0.1 (API sur une autre machine)
AGENT_TOKEN=
