APP_ENV=production
DATABASE_URL=postgresql+psycopg://caisse:<mot-de-passe>@db:5432/caisse
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=30
# En développement uniquement : CORS_ORIGINS=* (autorise toute origine ; ignoré si APP_ENV=production)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Swagger (/docs) et /openapi.json : actifs hors production ; ENABLE_DOCS=true les garde en production
# ENABLE_DOCS=true
# En-tête Host accepté (ex. caisse.local,192.168.1.10) ; * : tous (réseau local)
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=2097152
# Requêtes par minute et par adresse IP sur /auth/login, /auth/override (et /auth/refresh)
LOGIN_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=30

PRINT_AGENT_URL=http://host.docker.internal:8090
PRINT_AGENT_TOKEN=
PRINTER_WIDTH=48
DRAWER_PULSE=ESC_P_0_25_250

FNE_PROVIDER=manual
FNE_SYNC_TIMEOUT_SECONDS=4
# FNE test : http://54.247.95.108/ws — prod : URL transmise par la DGI après validation
FNE_API_BASE_URL=
FNE_API_KEY=

TZ=Africa/Abidjan
BACKUP_DIR=/var/backups/caisse
BACKUP_REMOTE_TARGET=
