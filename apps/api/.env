APP_NAME="Caisse MYK API"
APP_ENV="development"
DEBUG=true
PORT=8001
HOST="0.0.0.0"

# Base de données SQLite locale pour dev
DATABASE_URL="sqlite:///./caisse_dev.db"

# Sécurité & Auth
JWT_SECRET="changeme_in_production_super_secret_key_minimum_64_characters_long_123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=24

# Fuseau horaire
TZ="Africa/Abidjan"

# Intégrations
PRINT_AGENT_URL="http://127.0.0.1:8090"
ENABLE_HARDWARE_PRINTING="true"
FNE_PROVIDER="manual"
BACKUP_DIR="./backups"
